on boot
    chown system system /dev/xiaomi-touch
    chmod 0664 /dev/xiaomi-touch
    chown system system /sys/class/touch/tp_dev/fod_status
    chmod 0664 /sys/class/touch/tp_dev/fod_status

service vendor.touchfeature-default /vendor/bin/hw/vendor.xiaomi.hardware.touchfeature-service
    class hal
    user system
    group system
    task_profiles ServiceCapacityLow

service toucheventcheck /vendor/bin/toucheventcheck
    class main
    user root
    group system
    oneshot
    task_profiles ServiceCapacityLow
    disabled
